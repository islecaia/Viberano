# development | production (por defecto: production). En development, la cookie de sesión se
# sirve también por HTTP (secure=False) — necesario para probar desde el móvil en la red local,
# donde el navegador no trata http://<ip-local> como origen seguro. Deja esto sin definir (o en
# production) en cualquier despliegue real.
APP_ENV=development

# Sesión de persona autorizada (research.md §6)
SESSION_SECRET=changeme-generate-a-random-secret

# Lista de identidades autorizadas (separadas por coma), p.ej. isleca@protonmail.com
AUTHORIZED_ACCOUNTS=isleca@protonmail.com

# Contraseña compartida para el login mínimo (research.md §6) — cámbiala en despliegue real
APP_PASSWORD=changeme

# Credenciales IMAP genérico (usadas por app/services/mailbox/imap.py)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Credenciales OAuth2 de Gmail API (usadas por app/services/mailbox/gmail.py)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Credenciales OAuth2 de Microsoft Graph (usadas por app/services/mailbox/graph.py)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_REDIRECT_URI=http://localhost:8000/auth/graph/callback

# Clasificación con Anthropic API (research.md §4) — uso acotado, Principio VII de la constitution
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MONTHLY_BUDGET_USD=20

# Almacenamiento local de adjuntos y base de datos
ATTACHMENT_STORE_DIR=./data/attachments
SQLITE_DB_PATH=./data/invoice_manager.db
